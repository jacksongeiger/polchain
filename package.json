{
  "name": "polchain",
  "version": "1.0.0",
  "description": "PoLChain — Proof of Learning Protocol on Base Sepolia",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "deploy:baseSepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "node": "hardhat node",
    "frontend": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "postTask": "node scripts/postTask.js",
    "prove-server": ".venv/bin/python zk/server/server.py",
    "simulate": "node scripts/simulateMiners.js",
    "finalize": "node scripts/finalizeExpired.js",
    "auto-finalize": "node scripts/autoFinalize.js",
    "verify": "node scripts/verify.js",
    "redeploy:taskmanager": "node scripts/redeployTaskManager.js",
    "era:deploy": "node scripts/deployEra.js",
    "era:smoke": "node scripts/smokeEra.js",
    "era:promote": "node scripts/promoteEra.js",
    "era:rollback": "node scripts/promoteEra.js --rollback",
    "server": "node server/index.js",
    "mining": "concurrently --names \"loop,miner,srv\" --prefix-colors \"cyan,green,blue\" \"node scripts/miningLoop.js\" \"node scripts/autoMiner.js\" \"node server/index.js\""
  },
  "keywords": [
    "blockchain",
    "base",
    "solidity",
    "proof-of-learning"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
