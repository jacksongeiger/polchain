{
  "name": "polchain",
  "version": "1.0.0",
  "description": "PoLChain — Proof of Learning Protocol on Base Sepolia",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "deploy:baseSepolia": "hardhat run scripts/deploy.js --network baseSepolia",
